<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>IncreaseDifficultyMod</AssemblyName>
    <Product>IncreaseDifficultyMod</Product>
    <!-- Preserve code/resource identities and saved integrations after the public rename. -->
    <RootNamespace>IncreaseHardMod</RootNamespace>
    <Version>0.6.3</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
    <NoWarn>$(NoWarn);CS0436;CS0618;Publicizer001</NoWarn>

    <!-- Path to the REPO game install (for referencing/publicizing the game assemblies).
         Override with -p:GameDir=... if it ever moves. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\REPO</GameDir>
    <ManagedDir>$(GameDir)\REPO_Data\Managed</ManagedDir>

    <!-- The game is launched via Thunderstore Mod Manager, which loads plugins from the
         active profile folder (NOT the Steam install). Deploy there so builds actually
         take effect in-game. Override with -p:PluginsDir=... to target a different profile. -->
    <PluginsDir Condition="'$(PluginsDir)' == ''">$(AppData)\Thunderstore Mod Manager\DataFolder\REPO\profiles\Default\BepInEx\plugins\Whiteslove-IncreaseHardMod</PluginsDir>
  </PropertyGroup>

  <!-- _decompiled/ is a read-only reference dump of the game code; never compile it. -->
  <ItemGroup>
    <Compile Remove="_decompiled\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="unity\**\*.cs" />
    <None Include="_decompiled\**\*.cs" />
  </ItemGroup>

  <!-- Upgrade icons: embedded into the DLL so they ship as a single file (no extra deploy). -->
  <ItemGroup>
    <EmbeddedResource Include="src\Textures\*.png" />
    <EmbeddedResource Include="src\Art\*.png" />
    <EmbeddedResource Include="src\Art\*.mesh.json" />
    <EmbeddedResource Include="src\Audio\*.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.21" IncludeAssets="compile" />
  </ItemGroup>

  <!-- Reference the game assemblies directly and publicize them so we can touch private members. -->
  <ItemGroup>
    <Reference Include="PhotonVoice">
      <HintPath>$(ManagedDir)\PhotonVoice.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonVoice.API">
      <HintPath>$(ManagedDir)\PhotonVoice.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonVoice.PUN">
      <HintPath>$(ManagedDir)\PhotonVoice.PUN.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(ManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(ManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(ManagedDir)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Needed to recolour the game's native ping highlight (ValuableDiscoverGraphic uses UI.Image). -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Needed to render HUD text with the game's own TMP pixel font (Level Info overlay). -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- REPOLib (Zehs) — required dependency for registering custom shop upgrades.
         Vendored under libs/ so the mod compiles without a local game install; players
         must also install REPOLib via the mod manager for it to work at runtime. -->
    <Reference Include="REPOLib">
      <HintPath>libs\REPOLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <!-- Deployment is explicit so packaging/building never adds a second active DLL to a profile. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(PluginsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)" />
    <Move SourceFiles="$(PluginsDir)\IncreaseHardMod.dll"
          DestinationFiles="$(PluginsDir)\IncreaseHardMod.dll.disabled-before-rename"
          Condition="Exists('$(PluginsDir)\IncreaseHardMod.dll')" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll -> $(PluginsDir)" />
  </Target>

</Project>
